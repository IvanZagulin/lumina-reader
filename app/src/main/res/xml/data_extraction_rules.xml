<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup and device-transfer rules for Android 12+ (android:dataExtractionRules).
    Android 11 and below use backup_rules.xml; keep both files in sync.

    Only the listed paths are copied: all database files (including -wal/-shm),
    all SharedPreferences and the Preferences DataStore files in files/datastore/.
    files/books, files/covers and the cache are deliberately left out (too large
    for backup quotas); the library copes with rows whose book file is missing.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="datastore/" />
    </device-transfer>
</data-extraction-rules>
